# Phoenix 一键部署包 —— 环境变量模板（复制为 .env 后按需修改）
PHOENIX_HTTP_PORT=9080          # 唯一对外端口（R-01）
PG_PASSWORD=phoenix             # 生产务必改（内网库弱口令红线见 README）
IMAGE_TAG=v1.2.1
JAVA_OPTS=-XX:MaxRAMPercentage=70 -XX:+UseContainerSupport

# 基础镜像（默认走 docker.io；受限网络填镜像加速前缀的完整标签）
PGVECTOR_IMAGE=pgvector/pgvector:pg16
REDIS_IMAGE=redis:7-alpine
PGCLIENT_IMAGE=postgres:16-alpine
JRE_BASE_IMG=eclipse-temurin:21-jre-jammy
NGINX_BASE_IMG=nginx:1.27-alpine
