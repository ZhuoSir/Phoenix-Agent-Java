# syntax=docker/dockerfile:1.6
# Phoenix 后端镜像：多阶段（构建=工程现行 mvn 流程，零改码）
# 构建机若需内网 maven 仓：--build-arg MAVEN_SETTINGS=docker/maven/settings.example.xml 并在构建前复制到上下文
ARG MAVEN_IMAGE=maven:3.9-eclipse-temurin-23
FROM ${MAVEN_IMAGE} AS build
WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/root/.m2 \
    mvn -q package -DskipTests -Dspring-javaformat.skip=true -pl phoenix-admin/phoenix-admin-manager -am

# 运行层：字节码实测 major=65(Java21, T-01③) → 21-jre 可用
FROM eclipse-temurin:21-jre-jammy AS run
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -u 10001 app
WORKDIR /app
COPY --from=build /src/phoenix-admin/phoenix-admin-manager/target/phoenix-admin.jar /app/phoenix-admin.jar
RUN mkdir -p /app/logs && chown -R app:app /app
USER app
ENV JAVA_OPTS="-XX:MaxRAMPercentage=70 -XX:+UseContainerSupport" \
    TZ=Asia/Shanghai \
    LANG=C.UTF-8
EXPOSE 8066
ENTRYPOINT ["sh","-c","exec java $JAVA_OPTS -jar /app/phoenix-admin.jar"]
