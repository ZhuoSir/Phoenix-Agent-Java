# Phoenix 后端镜像（thin：host 预构建 jar → 薄镜像组装；构建零外网依赖）
# 基座要求：glibc + java(≥21)。默认 eclipse-temurin；受限网络可用 JRE_BASE_IMG 指向
# 任意含 JDK 的本地基座（本机验证实测用 ES9 镜像 java25 + JAVA_BIN 覆盖）。多阶段版见 Dockerfile.backend.multistage
ARG JRE_BASE_IMG=eclipse-temurin:21-jre-alpine
FROM ${JRE_BASE_IMG}
ARG JAVA_BIN=java
# 基座可能自带非 root 用户(如 ES 镜像)，构建层需 root
# python3 为 LocalCodePoolExecutorService 启动硬依赖；curl 供 healthcheck。三分支适配 基座发行版(debian/alpine/UBI)
USER root
# 工具链三件套（BUG-48）：python3+pip 之外，svg→png 转换器(rsvg-convert)与 CJK 字体
# 预装进镜像。2026-10-09 用户口令「权限应该放开，他要是需要依赖就让他安装才对，可以预装」：
# 由"只预装、不许装"改为 **预装 + 放开运行期安装**（见下方 PYTHONUSERBASE/PIP_USER/pip.conf 段）
# 实测(UBI/ES9 基座)：librsvg2 不含 rsvg-convert CLI，但 pip cairosvg 开箱可用（依赖库基座已带）；
# CJK 字体仓库无包，构建期下载烧入（jsdelivr；构建机需联网——交付物自带字体，离线机免装）
RUN (apt-get update -qq && apt-get install -y -qq --no-install-recommends curl python3 python3-pip librsvg2-bin fonts-noto-cjk && rm -rf /var/lib/apt/lists/*) \
    || (apk add --no-cache curl python3 py3-pip librsvg font-noto-cjk) \
    || (microdnf install -y python3 python3-pip fontconfig cairo && microdnf clean all)
RUN mkdir -p /usr/share/fonts/cjk \
    && (curl -fsL --max-time 120 -o /usr/share/fonts/cjk/NotoSansCJKsc-Regular.otf \
        https://cdn.jsdelivr.net/gh/notofonts/noto-cjk@main/Sans/OTF/SimplifiedChinese/NotoSansCJKsc-Regular.otf \
        || curl -fsL --max-time 120 -o /usr/share/fonts/cjk/NotoSansCJKsc-Regular.otf \
        https://mirrors.tuna.tsinghua.edu.cn/github-release/notofonts/noto-cjk/LatestRelease/NotoSansCJKsc-Regular.otf \
        || echo 'WARN: CJK 字体下载失败（中文渲染将缺字体）') \
    && (command -v fc-cache >/dev/null && fc-cache -f || true)
RUN python3 -m pip install --no-cache-dir cairosvg \
    || echo 'WARN: pip cairosvg 安装失败（svg 转 png 能力降级）'
# ===== 运行期依赖安装能力（2026-10-09 用户口令：放开权限 + 预装）=====
# 背景：应用以 uid 10001 运行，系统 site-packages 属 root 不可写、HOME=/ 不可写，
# 因此此前智能体 `pip install` 必失败（实测报 Errno 13 Permission denied: '/.local'）——
# 而技能（如报告生成）需要 python-docx 之类依赖。方案：
#   ① PYTHONUSERBASE 指到 /app 下的可写目录 ⇒ `pip install X` 落到 /app/.local，Python 自动可见；
#   ② 常用文档类依赖预装进同目录（离线/无网也能用）；
#   ③ compose 用 named volume 挂 /app/.local ⇒ 运行期装的包**跨容器重建保留**；
#   ④ pip 超时/重试放大 + 国内镜像兜底（实测 pypi 索引页很大，默认 15s 易超时）。
ENV PYTHONUSERBASE=/app/.local \
    PIP_USER=1 \
    PIP_CACHE_DIR=/app/.cache/pip \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN mkdir -p /app/.local /app/.cache/pip /etc/pip \
    && printf '[global]\nindex-url = https://pypi.tuna.tsinghua.edu.cn/simple\nextra-index-url = https://pypi.org/simple\ntimeout = 120\nretries = 5\n' > /etc/pip.conf
RUN python3 -m pip install --no-cache-dir --user python-docx openpyxl python-pptx pillow \
    || echo 'WARN: 文档类依赖预装失败（运行期仍可自行 pip install）'
RUN (chown -R 10001:10001 /app/.local /app/.cache 2>/dev/null || chmod -R 777 /app/.local /app/.cache)

ENV JAVA_BIN=${JAVA_BIN} \
    JAVA_OPTS="-XX:MaxRAMPercentage=70 -XX:+UseContainerSupport" \
    TZ=Asia/Shanghai \
    LANG=C.UTF-8
RUN mkdir -p /app/logs /app/uploads \
    && (chown -R 10001:10001 /app 2>/dev/null || chmod -R 777 /app)
WORKDIR /app
COPY --chown=app:app docker/.stage/phoenix-admin.jar /app/phoenix-admin.jar
USER 10001
EXPOSE 8066
ENTRYPOINT ["sh","-c","exec ${JAVA_BIN:-java} $JAVA_OPTS -jar /app/phoenix-admin.jar"]
