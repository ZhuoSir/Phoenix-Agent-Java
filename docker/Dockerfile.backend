# Phoenix 后端镜像（thin：host 预构建 jar → 薄镜像组装；构建零外网依赖）
# 多阶段版（需出网）见 Dockerfile.backend.multistage
ARG JRE_BASE_IMG=eclipse-temurin:21-jre-alpine
FROM ${JRE_BASE_IMG}
RUN adduser -S -u 10001 app
WORKDIR /app
COPY docker/.stage/phoenix-admin.jar /app/phoenix-admin.jar
RUN mkdir -p /app/logs && chown -R app:app /app
USER app
ENV JAVA_OPTS="-XX:MaxRAMPercentage=70 -XX:+UseContainerSupport" \
    TZ=Asia/Shanghai \
    LANG=C.UTF-8
EXPOSE 8066
ENTRYPOINT ["sh","-c","exec java $JAVA_OPTS -jar /app/phoenix-admin.jar"]
