<?xml version="1.0" encoding="UTF-8"?>
<!-- 国内网络默认：Maven 中央仓走阿里云（multistage 构建 ARG MAVEN_SETTINGS 默认值）。
     海外/内网仓场景：docker build 传 build-arg MAVEN_SETTINGS=docker/maven/settings.xml 覆盖。
     注意：XML 注释内禁止连续双横线（BUG-62 教训），参数写法避开两个减号连排 -->
<settings>
  <mirrors>
    <mirror>
      <id>aliyun-central</id>
      <mirrorOf>central</mirrorOf>
      <name>Aliyun Maven Central</name>
      <url>https://maven.aliyun.com/repository/public/</url>
    </mirror>
  </mirrors>
  <!-- 加固：连接/读超时 30s——mvn 默认无 socket 超时，死连接会永挂（bs 演练实证 18 分钟假死）；超时即失败可重跑，续用 buildkit 缓存 -->
  <servers>
    <server>
      <id>aliyun-central</id>
      <configuration>
        <timeout>30000</timeout>
      </configuration>
    </server>
  </servers>
</settings>
