# [需出网] vben monorepo 容器内构建（engines 要求 node ^22.18||^24）
# NODE_IMAGE/NGINX_IMAGE 可 build-arg 注入 mirror 前缀（package.sh T-02）；默认值=历史行为（身份①不变）
ARG NODE_IMAGE=node:22-bookworm
ARG NGINX_IMAGE=nginx:latest
FROM ${NODE_IMAGE} AS build
# CI=true：构建上下文无 .git（.dockerignore 排除），monorepo 的 prepare 钩子
# `is-ci || lefthook install` 会因装不了 git hooks 炸掉整个 pnpm install（五跑真抓）
ENV CI=true
RUN corepack enable
WORKDIR /repo
COPY web-frontend/ ./
# 国内网络默认 npmmirror；海外 --build-arg NPM_REGISTRY=https://registry.npmjs.org
ARG NPM_REGISTRY=https://registry.npmmirror.com
RUN pnpm config set registry ${NPM_REGISTRY} && pnpm install --frozen-lockfile && pnpm -F @vben/web-ele build
# package.sh 工件提取阶段（T-02）：只带 dist 不带 node_modules；默认目标仍为末阶段（身份①不变）
FROM build AS dist
RUN mkdir -p /out && cp -r apps/admin-ui/dist /out/dist

FROM ${NGINX_IMAGE}
COPY --from=build /repo/apps/admin-ui/dist /usr/share/nginx/html
COPY docker/nginx/phoenix.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
