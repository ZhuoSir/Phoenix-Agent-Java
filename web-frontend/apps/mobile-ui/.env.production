
VITE_PORT=5999

VITE_BASE=/

# 接口地址
# BUG-154：生产基址必须为**空** —— 代码里的路径已自带 /api 或为裸域(/auth/*)，
# 而生产 nginx 只按前缀透传不剥层（BL-18），再叠一层 /api 会 404/410。
# dev 保持 /api（vite proxy rewrite 会剥掉一层），两端语义各自自洽。
VITE_GLOB_API_URL=

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
